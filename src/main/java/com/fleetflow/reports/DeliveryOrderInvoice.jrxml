	<dataset name="tableDataset" uuid="1bbce05e-d97c-4649-8ff2-ff0115fb7165">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="fleetflow"/>
		<query language="SQL"><![CDATA[SELECT * FROM public.delivery_order_item
INNER JOIN delivery_order dor ON delivery_order_item.delivery_order_id = dor.id
WHERE dor.nomor_do = $P{nomor_do}
ORDER BY dor.id ASC ]]></query>
